{
  "name": "launchsim-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:mutation": "pnpm --filter @launchsim/core run test:mutation",
    "test:integration": "pnpm --filter @launchsim/registry run test:integration",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@launchsim/core": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
